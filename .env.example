# Copy to .env and fill in. .env is ignored by git; never commit real keys.

# External APIs
JCDECAUX_API_KEY=
OPENWEATHER_API_KEY=
# Google Maps: browser key (referrer-restricted) + server key for Geocoding / Directions (IP-restricted).
# Without a server key the app falls back to the browser key, which Google rejects for server calls.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
# AI assistant
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# AWS RDS, only used with compose.rds.yaml.
# Use a database of its own (not the Flask project's): Flyway creates the tables on first start.
RDS_HOST=
RDS_PORT=3306
RDS_DATABASE=dublin_bikes_spring
RDS_USER=
RDS_PASSWORD=
